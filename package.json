{
  "name": "@knopkem/opencode-free",
  "version": "0.1.0",
  "description": "Automatic routing, failover, and health tracking for OpenCode free models",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-free": "./bin/opencode-free.js",
    "ocf": "./bin/ocf.js"
  },
  "exports": {
    ".": "./src/plugin.js",
    "./router": "./src/router.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/*.js && node --check bin/opencode-free.js && node --check bin/ocf.js",
    "probe": "node ./bin/opencode-free.js probe"
  },
  "dependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knopkem/opencode-free.git"
  },
  "homepage": "https://github.com/knopkem/opencode-free#readme",
  "bugs": {
    "url": "https://github.com/knopkem/opencode-free/issues"
  },
  "author": {
    "name": "Michael Knopke",
    "email": "knopkem@gmail.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "llm",
    "free-models",
    "model-router",
    "failover"
  ]
}
